{
  "name": "agent-orchestrator",
  "version": "1.0.0",
  "description": "GUI for orchestrating AI coding agents",
  "main": "./out/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "rebuild": "electron-rebuild -f -w node-pty",
    "test": "vitest",
    "test:changed": "vitest --changed",
    "test:related": "vitest related",
    "test:watch": "vitest --changed --watch",
    "test:memory": "NODE_OPTIONS='--max-old-space-size=2048' vitest",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:headed": "playwright test --config=playwright.config.ts --headed",
    "test:e2e:debug": "playwright test --config=playwright.config.ts --debug",
    "test:e2e:report": "playwright show-report e2e-report"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "chokidar": "^3.6.0",
    "electron-store": "^8.2.0",
    "node-pty": "^1.0.0",
    "recharts": "^3.6.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/rebuild": "^4.0.2",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^20.11.19",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^28.2.3",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^2.0.0",
    "jsdom": "^27.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.3",
    "vitest": "^3.2.4",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "zustand": "^4.5.1"
  }
}
