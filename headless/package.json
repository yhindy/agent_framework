{
  "name": "headless",
  "version": "0.1.0",
  "description": "Headless API server for agent framework - manage Claude Code agents without Electron",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed"
  },
  "dependencies": {
    "async-mutex": "^0.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.4"
  }
}
